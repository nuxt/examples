{
  "name": "nuxt-examples",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nuxi prepare shared && turbo run build --concurrency 80% && node .scripts/build.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "node .scripts/typecheck.mjs"
  },
  "devDependencies": {
    "@nuxt/cli": "^3.37.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "^24.19.2",
    "consola": "^3.4.2",
    "eslint": "^10.13.0",
    "pathe": "^2.0.3",
    "pkg-types": "^2.4.0",
    "tinyexec": "^1.3.1",
    "tinyglobby": "^0.2.17",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
